    }

    User <|-- Commercant
    User <|-- Client
    Commercant "1" -- "*" Offre : propose
    Client "1" -- "*" ClientOffre : participe
    Offre "1" -- "*" ClientOffre : est utilisée par
    User "1" -- "*" Rating : note
    User "1" -- "*" Rating : est noté par
    Client "1" -- "*" Transaction : effectue
    Commercant "1" -- "*" Transaction : reçoit
    User "1" -- "*" Paiement : effectue/reçoit
    Client "1" -- "*" ConversionCoins : convertit
    Transaction "1" -- "1" Commission : génère
    
    Conversation "1" -- "*" Message : contient
    User "1" -- "*" Message : envoie
    Conversation "*" -- "*" User : participe
    Conversation -- ConversationUser
    User -- ConversationUser
    
    Groupe "1" -- "*" GroupeUser : contient
    User "1" -- "*" GroupeUser : appartient
    User "1" -- "*" Groupe : crée
    
    Commercant "1" -- "*" Endroit : possède

    FormuleAbonnement "1" -- "*" AbonnementCommercant : propose
    Commercant "1" -- "*" AbonnementCommercant : souscrit
    AbonnementCommercant "1" -- "*" HistoriqueFacturation : génère